{
  "info": {
    "_postman_id": "idlix-api-v3-collection",
    "name": "IDLIX API v3",
    "description": "Postman Collection for IDLIX REST API v3 — Scraper with Cloudflare Bypass and Stream Extraction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🏠 General & Homepage",
      "item": [
        {
          "name": "API Root Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Check if IDLIX API server is online and running."
          }
        },
        {
          "name": "Get Homepage Content (Flat)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/home",
              "host": ["{{base_url}}"],
              "path": ["api", "home"]
            },
            "description": "Returns all homepage content as a flat array."
          }
        },
        {
          "name": "Get Homepage Sections (Grouped)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/home/sections",
              "host": ["{{base_url}}"],
              "path": ["api", "home", "sections"]
            },
            "description": "Returns homepage content grouped by section (Featured, CinemaXXI, Trending, etc.)."
          }
        },
        {
          "name": "Get Featured Content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/featured",
              "host": ["{{base_url}}"],
              "path": ["api", "featured"]
            },
            "description": "Returns featured / trending content items."
          }
        },
        {
          "name": "Get CinemaXXI Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cinemaxxi",
              "host": ["{{base_url}}"],
              "path": ["api", "cinemaxxi"]
            },
            "description": "Returns recently added CinemaXXI movies."
          }
        }
      ]
    },
    {
      "name": "🔍 Search",
      "item": [
        {
          "name": "Search Content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/search?q=batman",
              "host": ["{{base_url}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "batman",
                  "description": "Search query keyword"
                }
              ]
            },
            "description": "Search movies and series by title keyword."
          }
        }
      ]
    },
