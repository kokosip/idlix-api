              "raw": "{{base_url}}/api/movie/per-aspera-ad-astra-2026/stream",
              "host": ["{{base_url}}"],
              "path": ["api", "movie", "per-aspera-ad-astra-2026", "stream"]
            },
            "description": "Extracts streaming m3u8/json URL and subtitle tracks (.vtt) for a movie."
          }
        }
